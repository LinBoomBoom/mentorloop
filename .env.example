# ===== MentorLoop 环境变量样例 =====
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实密钥。

# 站点域名（sitemap / robots / 支付回调依赖，务必改成真实域名）
SITE_URL=https://mentorloop.example.com

# LLM（AI 模拟面试 / 学习路径 / 简历诊断）—— DeepSeek OpenAI 兼容端点
DEEPSEEK_API_KEY=

# 演示模式：true 时注册验证码明文回传（仅本地开发！生产必须 false 或 unset）
DEV_CODE=false

# 数据库路径（默认 data/devmentor.db；部署建议挂持久卷并显式指定绝对路径）
DB_PATH=

# 备份目录（B4 在线备份落点）
BACKUP_DIR=

# Nitro 监听端口
PORT=3000
NITRO_PORT=3000

# ===== 语音识别（ASR）—— 用于 Safari / Firefox 等不支持浏览器端语音识别的浏览器 =====
# 走 OpenAI 兼容 Whisper 端点。默认用 OpenAI；可经 ASR_BASE_URL 指向任意兼容服务
# （硅基流动 / Groq / 本地 whisper-server 等）。ASR_LANG 留空则自动检测语言。
# 未配置时，语音输入仅保留 Chrome/Edge 的浏览器端识别，Safari 会提示改用 Chrome 或手动输入。
ASR_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# ASR_LANG=zh

# ===== 语音合成（TTS）=====
# TTS_PROVIDER：piper（默认，本地离线神经网络，推荐）/ edge（云端微软，需联网且常被网络拦截）/ mock（测试）
# 默认不设置时：若已运行 `npm run setup:piper` 装好本地引擎则自动用 piper，否则回退 edge。
# TTS_VOICE：默认 Piper 嗓音 id（piper 模式下生效），可选 huayan（默认）/ xiao_ya / chaowen。
#             edge 模式忽略此值（固定使用 zh-CN-XiaoxiaoNeural）。
TTS_PROVIDER=
TTS_VOICE=
# 可选：自定义 Piper 二进制与模型目录（默认 data/piper/piper[.exe] 与 data/piper/models）
# PIPER_BIN=
# PIPER_MODELS_DIR=
