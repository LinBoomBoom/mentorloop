# MentorLoop 环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 忽略）

# 数据库路径（默认 data/devmentor.db；生产建议用绝对路径，避免 cwd 变化静默建空库）
# DB_PATH=/var/lib/mentorloop/data/devmentor.db

# 演示模式：true 时验证码明文回传（仅本地开发）；生产必须 unset 或 false，并接入真实短信/邮件
# DEV_CODE=false

# VIP / 支付总开关（默认开启；设 false 可临时下架购买入口）
# VIP_ENABLED=true

# 支付通道：sandbox（演示，整条链路可跑通）| wechat | alipay
PAY_PROVIDER=sandbox

# 站点域名（用于支付回调通知地址与 SEO 的 sitemap/robots；生产必须改成真实域名）
SITE_URL=https://mentorloop.com

# ---- 微信支付 v3（PAY_PROVIDER=wechat 时必填）----
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_API_V3_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY=

# ---- 支付宝（PAY_PROVIDER=alipay 时必填）----
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
