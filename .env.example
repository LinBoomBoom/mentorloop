# MentorLoop 环境变量模板（提交到仓库，不含任何密钥）
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略。

# 站点与数据库
SITE_URL=https://your-domain.com
DB_PATH=data/devmentor.db
DEV_CODE=false

# 支付（sandbox / wechat / alipay；真实通道需营业执照）
PAY_PROVIDER=sandbox

# LLM（Deepseek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 真实支付凭据（启用 wechat/alipay 时填写）
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_API_V3_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
