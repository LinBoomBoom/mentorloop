# ===== MentorLoop 环境变量样例 =====
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实密钥。

# 站点域名（sitemap / robots / 支付回调依赖，务必改成真实域名）
SITE_URL=https://mentorloop.example.com

# LLM（AI 模拟面试 / 学习路径 / 简历诊断）—— DeepSeek OpenAI 兼容端点
DEEPSEEK_API_KEY=

# 演示模式：true 时注册验证码明文回传（仅本地开发！生产必须 false 或 unset）
DEV_CODE=false

# 数据库路径（默认 data/devmentor.db；部署建议挂持久卷并显式指定绝对路径）
DB_PATH=

# 备份目录（B4 在线备份落点）
BACKUP_DIR=

# Nitro 监听端口
PORT=3000
NITRO_PORT=3000
