# ===== MentorLoop 环境变量样例 =====
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实密钥。

# 站点域名（sitemap / robots / 支付回调依赖，务必改成真实域名）
SITE_URL=https://mentorloop.example.com

# LLM（AI 模拟面试 / 学习路径 / 简历诊断）—— DeepSeek OpenAI 兼容端点
DEEPSEEK_API_KEY=

# 演示模式：true 时注册验证码明文回传（仅本地开发！生产必须 false 或 unset）
DEV_CODE=false

# 数据库路径（默认 data/devmentor.db；部署建议挂持久卷并显式指定绝对路径）
DB_PATH=

# 备份目录（B4 在线备份落点）
BACKUP_DIR=

# Nitro 监听端口
PORT=3000
NITRO_PORT=3000

# ===== 语音识别（ASR）—— 用于 Safari / Firefox 等不支持浏览器端语音识别的浏览器 =====
# 走 OpenAI 兼容 Whisper 端点。默认用 OpenAI；可经 ASR_BASE_URL 指向任意兼容服务
# （硅基流动 / Groq / 本地 whisper-server 等）。ASR_LANG 留空则自动检测语言。
# 未配置时，语音输入仅保留 Chrome/Edge 的浏览器端识别，Safari 会提示改用 Chrome 或手动输入。
ASR_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# ASR_LANG=zh

# ===== 语音合成（TTS）=====
# TTS_PROVIDER 可选值（不设置时默认 piper（本地离线，零网络依赖、最稳））：
#   piper  —— 本地离线神经网络，3 个中文模型已装（huayan/xiao_ya 女、chaowen 男），推荐零成本零网络
#   aliyun —— 阿里云 DashScope CosyVoice（国内节点 HTTP 直连，清晰男女声，不怕墙；需 DASHSCOPE_API_KEY）
#   edge   —— 云端微软神经嗓音（清晰男女声），但国内多数网络无法访问微软端点（403），仅作备选
#   mock   —— 测试用蜂鸣，绝不写入磁盘缓存
# 三人格 id（huayan / xiao_ya / chaowen）在前端下拉通用；各 provider 服务端映射成对应真实音色。
TTS_PROVIDER=
TTS_VOICE=

# 阿里云 DashScope（百炼）TTS：在 https://bailian.console.aliyun.com 获取 API Key 填入。
# 默认端点/模型已内置，下列为可选覆盖：
# ALIYUN_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# ALIYUN_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_API_KEY=
# TTS_VOICE 仅作备注：huayan→longxiaochun(女) / xiao_ya→longxiaoxia(女) / chaowen→longwan(男)

# 可选：自定义 Piper 二进制与模型目录（默认 data/piper/piper[.exe] 与 data/piper/models）
# PIPER_BIN=
# PIPER_MODELS_DIR=
