# Dependencies
node_modules

# Nuxt / Nitro build output
.output
.nuxt
.nuxt_run
.data

# Local database (re-seeded automatically on first run)
*.db
data/*.db

# Generated TTS/STT media cache (runtime artifacts, not source)
data/media/

# Local Piper offline TTS engine (binary + models, downloaded via `npm run setup:piper`, not source)
data/piper/

# 3D 数字人 VRM 模型（用户自备二进制资源，体积大，运行时从 /avatars 提供；.gitkeep 保留目录）
app/public/avatars/*.vrm

# Env files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Diagnostics / OS cruft
_diag_now.html
.DS_Store
Thumbs.db

# Local working memory (auto-generated project state, not source)
.workbuddy/

# Transient SQLite write-ahead log / shared-memory (regenerated at runtime)
data/*.db-shm
data/*.db-wal

# Seed / DB backups produced during content authoring
data/*.bak*
*.bak*

# Electron 构建产物（安装包 / 解包目录）
release/
dist_electron/
# 构建期内置的 node 二进制（由 scripts/bundle-node.mjs 复制，按构建机 node 版本生成，不入库）
extraResources/

# Electron 应用图标（由 npm run make:icon 生成，构建前自动产出）
build/icon.png
build/icon.ico
build/icon.icns
